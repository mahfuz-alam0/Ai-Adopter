# Copy to .env (git-ignored). Create an OAuth client (type: Web application) in Google Cloud Console and add
# ${BASE_URL}/auth/google/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Long random string, e.g. `openssl rand -hex 32`. Without it sessions reset on every server restart.
SESSION_SECRET=
# Public URL of apps/web, not of this server: the browser reaches this server through web's proxy.
# Default http://localhost:3000.
# BASE_URL=http://localhost:3000
# This server listens here; apps/web reads it as SERVER_URL (default http://localhost:4000).
# PORT=4000
